# Fastmail SMTP. Create an app password in Fastmail; do not use your account password.
SMTP_HOST=smtp.fastmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@servoict.com
SMTP_PASSWORD=replace-with-fastmail-app-password

# The inbox that receives project enquiries.
CONSULTATION_TO_EMAIL=support@servoict.com
CONSULTATION_FROM_EMAIL=website@servoict.com
CONSULTATION_FROM_NAME=Servo ICT Website

# Cloudflare Turnstile (free spam protection).
PUBLIC_TURNSTILE_SITE_KEY=replace-with-site-key
TURNSTILE_SECRET_KEY=replace-with-secret-key

# Local development only. Never set this to true in production.
FORM_ALLOW_INSECURE_LOCAL=false
