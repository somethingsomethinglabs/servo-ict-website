---
import '@fontsource-variable/inter/wght.css';

interface Props {
	title: string;
	description: string;
	canonicalPath: string;
	image?: string;
	type?: 'website' | 'article';
	publishedAt?: Date;
	updatedAt?: Date;
}

const {
	title,
	description,
	canonicalPath,
	image = '/og.png',
	type = 'website',
	publishedAt,
	updatedAt
} = Astro.props;

const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteOrigin = Astro.site ?? new URL('https://servoict.com');
const sitePath = (path: string) => `${baseUrl}${path.replace(/^\//, '')}`;
const canonicalUrl = new URL(sitePath(canonicalPath), siteOrigin);
const imageUrl = new URL(sitePath(image), siteOrigin);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/png" href={sitePath('/images/servo-ict-logo.png')} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="description" content={description} />
		<meta property="og:site_name" content="Servo ICT" />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:alt" content={description} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
		{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
		<title>{title}</title>
	</head>
	<body>
		<div class="site-shell">
			<header class="site-header">
				<a class="brand" href={baseUrl} aria-label="Servo ICT home">
					<img src={sitePath('/images/servo-ict-logo.png')} alt="" width="44" height="44" />
					<span>Servo ICT</span>
				</a>
				<nav aria-label="Blog navigation">
					<a href={sitePath('/blog/')}>All posts</a>
					<a href={`${baseUrl}#services`}>Project work</a>
					<a class="nav-cta" href={`${baseUrl}#consultation-form`}>Talk about your project</a>
				</nav>
			</header>

			<main>
				<slot />
			</main>

			<footer>
				<a class="brand" href={baseUrl} aria-label="Servo ICT home">
					<img src={sitePath('/images/servo-ict-logo.png')} alt="" width="44" height="44" />
					<span>Servo ICT</span>
				</a>
				<p>Websites and technology projects for small business.</p>
				<span>© {new Date().getFullYear()} Servo ICT</span>
			</footer>
		</div>
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}

	html {
		font-family:
			"Inter Variable", Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
			"Segoe UI", sans-serif;
		font-synthesis: none;
	}

	body {
		margin: 0;
		background: #f4f2ec;
		color: #10103f;
		font-family: inherit;
		line-height: 1.5;
		text-rendering: optimizeLegibility;
	}

	a {
		color: inherit;
	}

	img {
		max-width: 100%;
	}

	.site-shell {
		min-height: 100vh;
		overflow: hidden;
	}

	.site-header,
	footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		width: min(100% - 3rem, 1120px);
		margin: 0 auto;
	}

	.site-header {
		padding: 1.25rem 0;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		font-size: 1.02rem;
		font-weight: 750;
		letter-spacing: -0.02em;
		text-decoration: none;
	}

	.brand img {
		width: 2.4rem;
		height: 2.4rem;
	}

	.site-header nav {
		display: flex;
		align-items: center;
		gap: clamp(1rem, 2.5vw, 2rem);
	}

	.site-header nav a {
		font-size: 0.82rem;
		font-weight: 700;
		text-decoration: none;
	}

	.site-header nav a:hover,
	.site-header nav a:focus-visible {
		color: #4a4ab9;
	}

	.site-header nav .nav-cta {
		padding: 0.72rem 1rem;
		border-radius: 999px;
		background: #10105a;
		color: #fff;
	}

	.site-header nav .nav-cta:hover,
	.site-header nav .nav-cta:focus-visible {
		background: #282887;
		color: #fff;
	}

	footer {
		margin-top: 5rem;
		padding: 1.5rem 0 2.5rem;
		border-top: 1px solid #d0cdc3;
		color: #626277;
		font-size: 0.75rem;
	}

	footer p {
		margin: 0;
	}

	footer .brand {
		color: #10103f;
	}

	@media (max-width: 700px) {
		.site-header,
		footer {
			width: min(100% - 2rem, 1120px);
		}

		.site-header {
			gap: 1rem;
		}

		.site-header nav a:not(.nav-cta) {
			display: none;
		}

		.site-header nav .nav-cta {
			padding-inline: 0.85rem;
			font-size: 0.72rem;
		}

		footer {
			align-items: flex-start;
			flex-direction: column;
			gap: 1rem;
		}
	}
</style>
