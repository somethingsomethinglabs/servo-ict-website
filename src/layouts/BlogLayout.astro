---
import PageLayout from './PageLayout.astro';
interface Props {
 title:string; description:string; canonicalPath:string; image?:string;
 type?:'website'|'article'; publishedAt?:Date; updatedAt?:Date;
}
const active = Astro.props.canonicalPath === '/privacy/' ? '' : 'advice';
---
<PageLayout {...Astro.props} {active}><slot /></PageLayout>
