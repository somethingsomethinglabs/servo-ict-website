---
import PageLayout from './PageLayout.astro';
import PageIcon from '../components/PageIcon.astro';
import { sitePath } from '../lib/site';
interface Props {
 title: string;
 headline: string;
 description: string;
 canonicalPath: string;
 topic: string;
 author: string;
 publishedAt: Date;
 updatedAt?: Date;
 readingTime: number;
 image: string;
 imageAlt: string;
 headings?: Array<{ slug: string; text: string }>;
 helpLink?: { href: string; label: string };
 enquiryTopic?: string;
}
const { headline, description, topic, author, publishedAt, updatedAt, readingTime, image, imageAlt, headings = [], helpLink } = Astro.props;
const formatDate = (date: Date) => new Intl.DateTimeFormat('en-AU', { day:'numeric', month:'long', year:'numeric', timeZone:'Australia/Melbourne' }).format(date);
---
<PageLayout {...Astro.props} active="advice" type="article">
 <slot name="head" slot="head" />
 <article class="article-template">
  <header class="article-header section-space"><div class="container"><a class="back-link" href={sitePath('/blog/')}><span aria-hidden="true">←</span> All advice</a><div class="split article-hero"><div><p class="eyebrow">{topic}</p><h1>{headline}</h1><p class="lead">{description}</p><p class="byline">By {author}<span aria-hidden="true">·</span><time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>{updatedAt && <span>Updated <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time></span>}<span>{readingTime} min read</span></p></div><div class="article-photo"><img class="photo-frame" src={sitePath(image)} alt={imageAlt} width="1400" height="1120" fetchpriority="high" /></div></div></div></header>
  <div class:list={["container", "article-grid", "section-space", { "without-contents": headings.length === 0 }]}>
   {headings.length > 0 && <aside class="contents"><nav aria-label="In this article"><p class="eyebrow">In this article</p><ol>{headings.map(heading => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>{helpLink && <a class="text-link" href={helpLink.href}>{helpLink.label}<PageIcon name="arrowRight" size={20}/></a>}</nav></aside>}
   <div class="article-copy"><div class="prose"><slot /></div><slot name="after-content" /></div>
  </div>
 </article>
 <slot name="after-article" />
</PageLayout>
<style>
 .article-header { background-color:var(--plastic); border-bottom:1px solid var(--seam); box-shadow:inset 0 -1px 0 var(--edge); padding-top:2rem; }
 .back-link { display:inline-flex; gap:.8rem; align-items:center; min-height:44px; margin-bottom:2rem; color:var(--muted); font-size:.95rem; font-weight:700; text-decoration:none; }
 .article-hero { grid-template-columns:1.2fr 1fr; }
 .article-hero h1 { font-size:clamp(2.5rem,4.8vw,4.65rem); }
 .article-photo { padding:0 1rem 1rem 0; }
 .article-photo img { aspect-ratio:1.12; height:auto; object-fit:cover; }
 .byline { display:flex; flex-wrap:wrap; gap:.4rem .75rem; margin-top:2rem; color:var(--muted); font-size:.85rem; }
 .byline > span:last-child { flex-basis:100%; }
 .article-grid { display:grid; grid-template-columns:clamp(140px,17vw,220px) minmax(0,1fr); gap:clamp(3rem,7vw,7rem); align-items:start; }
 .contents { position:sticky; top:2rem; }
 .contents ol { list-style:none; padding:0; margin:0; }
 .contents li { border-bottom:1px solid var(--line); }
 .contents li a { display:block; min-height:44px; padding:.8rem 0; color:var(--muted); font-size:.95rem; }
 .contents .text-link { margin-top:1.5rem; }
 .article-copy { min-width:0; max-width:var(--reading-measure); font-size:1.1rem; }
 .prose { font-size:1.1rem; line-height:1.65; color:var(--muted); }
 .prose :global(> :first-child) { margin-top:0; }
 .prose :global(h2) { margin:3.5rem 0 1.2rem; padding-top:1.5rem; border-top:1px solid var(--line); color:var(--ink); font-size:clamp(1.7rem,2.5vw,2.4rem); line-height:1.18; letter-spacing:-.045em; }
 .prose :global(h3) { margin:2rem 0 .8rem; color:var(--ink); font-size:1.35rem; }
 .prose :global(p),.prose :global(ul),.prose :global(ol) { margin:1.2rem 0; }
 .prose :global(li + li) { margin-top:.6rem; }
 .prose :global(a) { color:var(--ink); font-weight:700; text-decoration-color:var(--ink); text-decoration-thickness:2px; overflow-wrap:anywhere; }
 .prose :global(blockquote) { margin:2rem 0; padding:1rem 1.5rem; border-left:5px solid var(--ink); background-color:var(--plastic); }

 .article-grid.without-contents .article-copy { margin-inline:auto; }
 .article-grid.without-contents { grid-template-columns:minmax(0,1fr); justify-content:center; }
 @media(max-width:1050px){.article-grid{gap:2.5rem}}
 @media(max-width:700px){.article-hero,.article-grid{grid-template-columns:1fr}.article-header{padding-top:1.5rem}.contents{position:static}.contents ol{display:grid;gap:0}.article-grid{gap:3rem}.article-copy{font-size:1.05rem}.prose{font-size:1.05rem;line-height:1.65}}
 .prose :global(img) { height:auto; }
 .prose :global(pre) { max-width:100%; overflow-x:auto; }
 .prose :global(table) { display:block; max-width:100%; overflow-x:auto; border-collapse:collapse; }
 .prose :global(th),.prose :global(td) { padding:.75rem; border-bottom:1px solid var(--line); text-align:left; }
 .prose :global(figure) { margin:2rem 0; }
 .prose :global(figcaption) { font-size:.9rem; }
</style>
