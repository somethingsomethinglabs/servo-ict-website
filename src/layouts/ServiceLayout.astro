---
import '@fontsource-variable/inter/wght.css';

interface EnquiryAnswer {
	question: string;
	answer: string;
}

interface Props {
	title: string;
	description: string;
	canonicalPath: string;
	eyebrow: string;
	headline: string;
	intro: string;
	goodFit: string[];
	typicalWork: Array<{ title: string; description: string }>;
	enquiryService: 'website' | 'technology' | 'security';
	beforeEnquiring: EnquiryAnswer[];
	exampleScope: {
		scenario: string;
		work: string;
		inputs: string;
		timing: string;
		handover: string;
	};
	closingTitle: string;
	closingCopy: string;
}

const {
	title,
	description,
	canonicalPath,
	eyebrow,
	headline,
	intro,
	goodFit,
	typicalWork,
	enquiryService,
	beforeEnquiring,
	exampleScope,
	closingTitle,
	closingCopy
} = Astro.props;

const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteOrigin = Astro.site ?? new URL('https://servoict.com');
const sitePath = (path: string) => `${baseUrl}${path.replace(/^\//, '')}`;
const canonicalUrl = new URL(sitePath(canonicalPath), siteOrigin);
const enquiryUrl = `${baseUrl}?service=${enquiryService}#consultation-form`;
const serviceLinks = [
	{ label: 'Websites', path: '/websites/' },
	{ label: 'Business IT', path: '/business-it/' },
	{ label: 'Security', path: '/security/' }
];
const schema = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: headline,
	description,
	provider: {
		'@type': 'ProfessionalService',
		name: 'Servo ICT',
		url: new URL(baseUrl, siteOrigin).toString(),
		areaServed: ['Gippsland', 'Victoria']
	},
	url: canonicalUrl.toString()
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/png" href={sitePath('/images/servo-ict-logo.png')} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Servo ICT" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(sitePath('/og.png'), siteOrigin)} />
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<header class="site-header">
			<a class="brand" href={baseUrl} aria-label="Servo ICT home">
				<img src={sitePath('/images/servo-ict-logo.png')} alt="" width="44" height="44" />
				<span>Servo ICT</span>
			</a>
			<nav aria-label="Main navigation">
				<a href={`${baseUrl}#services`}>Project work</a>
				<a href={`${baseUrl}#about`}>About</a>
				<a class="nav-cta" href={enquiryUrl}>Project enquiry</a>
			</nav>
		</header>

		<main id="main-content">
			<section class="hero">
				<div>
					<p class="eyebrow">{eyebrow}</p>
					<h1>{headline}</h1>
				</div>
				<div class="hero-intro">
					<p>{intro}</p>
					<p class="hero-qualifier"><strong>A good fit when</strong><span>{goodFit[0]}</span></p>
					<a class="button" href={enquiryUrl}>Discuss your project <span aria-hidden="true">→</span></a>
				</div>
			</section>

			<nav class="service-switcher" aria-label="Compare services">
				<span>Compare services</span>
				<div>
					{serviceLinks.map((service) => (
						<a href={sitePath(service.path)} aria-current={service.path === canonicalPath ? 'page' : undefined}>{service.label}</a>
					))}
				</div>
			</nav>

			<nav class="page-jumps" aria-label="On this page">
				<span>On this page</span>
				{Astro.slots.has('offer') && <a href="#website-offer">Website offer</a>}
				{Astro.slots.has('proof') && <a href="#service-proof">{enquiryService === 'website' ? 'Client work' : 'Experience'}</a>}
				{Astro.slots.has('technology') && <a href="#website-technology">Built with Astro</a>}
				<a href="#typical-work">Typical work</a>
				<a href="#before-enquiring">FAQs</a>
				<a href="#example-scope">Example scope</a>
				<a href="#process">Process</a>
			</nav>

			{Astro.slots.has('offer') && <slot name="offer" />}

			{Astro.slots.has('proof') && <div id="service-proof"><slot name="proof" /></div>}

			<section class="fit" aria-labelledby="fit-title">
				<div><p class="eyebrow">A good fit when</p><h2 id="fit-title">Is this service right for you?</h2></div>
				<ul>{goodFit.slice(1).map((item) => <li>{item}</li>)}</ul>
			</section>

			<section class="work" id="typical-work" aria-labelledby="work-title">
				<div class="section-heading"><p class="eyebrow">Typical project work</p><h2 id="work-title">What we can help with</h2></div>
				<div class="work-grid">
					{typicalWork.map((item, index) => (
						<article><span>{String(index + 1).padStart(2, '0')}</span><h3>{item.title}</h3><p>{item.description}</p></article>
					))}
				</div>
			</section>

			<section class="before-enquiring" id="before-enquiring" aria-labelledby="before-enquiring-title">
				<div class="section-heading">
					<p class="eyebrow">Useful details</p>
					<h2 id="before-enquiring-title">Before you enquire</h2>
				</div>
				<div class="faq-list">
					{beforeEnquiring.map((item, index) => (
						<details open={index === 0}><summary>{item.question}</summary><p>{item.answer}</p></details>
					))}
				</div>
			</section>

			<section class="example-scope" id="example-scope" aria-labelledby="example-scope-title">
				<div class="section-heading">
					<p class="eyebrow">Possible engagement</p>
					<h2 id="example-scope-title">Example scope</h2>
					<p>{exampleScope.scenario}</p>
					<small>This is an example, not a completed client project.</small>
				</div>
				<details class="scope-details">
					<summary>See the project scope</summary>
					<dl>
						<div><dt>Likely work</dt><dd>{exampleScope.work}</dd></div>
						<div><dt>What you provide</dt><dd>{exampleScope.inputs}</dd></div>
						<div><dt>Quote and timing</dt><dd>{exampleScope.timing}</dd></div>
						<div><dt>Handover</dt><dd>{exampleScope.handover}</dd></div>
					</dl>
				</details>
			</section>

			{Astro.slots.has('technology') && <slot name="technology" />}

			<section class="process" id="process" aria-labelledby="process-title">
				<div><p class="eyebrow eyebrow-light">Project steps</p><h2 id="process-title">How the project works</h2></div>
				<ol>
					<li><span>01</span><div><strong>Scope</strong><p>Agree on the outcome, boundaries, quote and schedule.</p></div></li>
					<li><span>02</span><div><strong>Deliver</strong><p>Complete the agreed work with progress updates and review points.</p></div></li>
					<li><span>03</span><div><strong>Handover</strong><p>Receive the working result, notes and agreed next steps.</p></div></li>
				</ol>
			</section>

			<section class="closing">
				<div><p class="eyebrow">Next step</p><h2>{closingTitle}</h2></div>
				<div><p>{closingCopy}</p><a class="button" href={enquiryUrl}>Send a project enquiry <span aria-hidden="true">→</span></a></div>
			</section>
		</main>

		<footer>
			<div><a class="brand" href={baseUrl}><img src={sitePath('/images/servo-ict-logo.png')} alt="" width="44" height="44" /><span>Servo ICT</span></a><p>Websites and technology projects for small business.</p></div>
			<nav aria-label="Footer navigation"><a href={sitePath('/websites/')}>Websites</a><a href={sitePath('/business-it/')}>Business IT</a><a href={sitePath('/security/')}>Security</a><a href={sitePath('/privacy/')}>Privacy</a></nav>
			<div class="footer-contact"><a href="mailto:support@servoict.com">support@servoict.com</a><a href="tel:0341488665">(03) 4148 8665</a><span>© {new Date().getFullYear()} Servo ICT</span></div>
		</footer>
	</body>
</html>

<style is:global>
	* { box-sizing: border-box; }
	html { font-family: "Inter Variable", Inter, ui-sans-serif, system-ui, sans-serif; font-synthesis: none; }
	body { margin: 0; background: #f4f2ec; color: #10103f; line-height: 1.5; text-rendering: optimizeLegibility; }
	a { color: inherit; }
	:focus-visible { outline: 3px solid #5c5ce0; outline-offset: 4px; }
	.skip-link { position: fixed; z-index: 100; top: .75rem; left: .75rem; padding: .75rem 1rem; transform: translateY(-200%); border-radius: .5rem; background: #fff; font-weight: 800; }
	.skip-link:focus { transform: translateY(0); }
	.site-header, main > section, main > div, .service-switcher, .page-jumps, footer { width: min(100% - 3rem, 1120px); margin-inline: auto; }
	.site-header { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding: 1.25rem 0; }
	.brand { display: inline-flex; align-items: center; gap: .75rem; font-size: 1.02rem; font-weight: 760; text-decoration: none; }
	.brand img { width: 2.4rem; height: 2.4rem; }
	.site-header nav { display: flex; align-items: center; gap: clamp(1rem, 3vw, 2.5rem); }
	.site-header nav a, footer nav a { font-size: .8rem; font-weight: 720; text-decoration: none; }
	.nav-cta, .button { display: inline-flex; min-height: 2.75rem; align-items: center; justify-content: center; padding: .75rem 1.15rem; border-radius: 999px; background: #10105a; color: #fff; font-weight: 760; text-decoration: none; }
	.button { min-height: 3.4rem; gap: 1.5rem; padding-inline: 1.5rem; font-size: .84rem; }
	.nav-cta:hover, .button:hover { background: #282887; }
	.hero { display: grid; min-height: 30rem; grid-template-columns: minmax(0, 1.18fr) minmax(20rem, .82fr); align-items: center; gap: clamp(3rem, 9vw, 8rem); padding-block: clamp(3.5rem, 7vw, 5.5rem); border-top: 1px solid #d5d2c8; }
	.eyebrow { margin: 0 0 1.2rem; color: #4a4ab9; font-size: .72rem; font-weight: 850; letter-spacing: .13em; text-transform: uppercase; }
	h1 { max-width: 12ch; margin: 0; font-size: clamp(3.2rem, 6.8vw, 6.2rem); line-height: .96; letter-spacing: -.055em; }
	.hero-intro > p:not(.hero-qualifier), .closing > div:last-child > p { margin: 0 0 1.5rem; color: #5b5b70; font-size: 1.08rem; line-height: 1.75; }
	.hero-qualifier { display: grid; gap: .35rem; margin: 0 0 1.6rem; padding: .9rem 1rem; border-left: 3px solid #f8a51b; background: rgb(255 255 255 / 55%); color: #393951; font-size: .88rem; line-height: 1.55; }
	.hero-qualifier strong { color: #4a4ab9; font-size: .68rem; letter-spacing: .1em; text-transform: uppercase; }
	.hero-qualifier span { font-weight: 680; }
	.service-switcher { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding-block: 1rem; border-top: 1px solid #d5d2c8; border-bottom: 1px solid #d5d2c8; }
	.service-switcher > span { color: #626277; font-size: .7rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
	.service-switcher > div { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .5rem; }
	.service-switcher a { display: inline-flex; min-height: 2.5rem; align-items: center; padding: .55rem 1rem; border: 1px solid #c7c4bb; border-radius: 999px; font-size: .78rem; font-weight: 760; text-decoration: none; }
	.service-switcher a:hover { border-color: #4a4ab9; color: #282887; }
	.service-switcher a[aria-current='page'] { border-color: #10105a; background: #10105a; color: #fff; }
	.page-jumps { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem 1.25rem; padding-block: 1rem; border-bottom: 1px solid #d5d2c8; }
	.page-jumps span { margin-right: auto; color: #626277; font-size: .68rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
	.page-jumps a { display: inline-flex; min-height: 2.75rem; align-items: center; padding-block: .35rem; color: #393951; font-size: .78rem; font-weight: 720; text-decoration-color: #aaa7bf; text-underline-offset: .3rem; }
	.page-jumps a:hover { color: #4a4ab9; text-decoration-color: #4a4ab9; }
	.fit { display: grid; grid-template-columns: minmax(0, .85fr) minmax(22rem, 1.15fr); gap: clamp(3rem, 9vw, 8rem); padding-block: clamp(4rem, 8vw, 7rem); }
	h2 { margin: 0; font-size: clamp(2.25rem, 4.8vw, 4.2rem); line-height: 1.02; letter-spacing: -.048em; }
	.fit h2 { max-width: 11ch; }
	.fit ul { margin: 0; padding: 0; list-style: none; }
	.fit li { padding: 1.2rem 0; border-bottom: 1px solid #d5d2c8; font-size: 1.05rem; font-weight: 720; }
	.fit li:first-child { padding-top: .25rem; }
	.work { padding-block: clamp(5rem, 9vw, 8rem); }
	.section-heading { max-width: 44rem; margin-bottom: 3.5rem; }
	.work-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
	.work article { min-height: 15rem; padding: clamp(1.5rem, 3vw, 2.4rem); border-top: 1px solid #aaa7bf; background: transparent; }
	.work article:nth-child(2), .work article:nth-child(3) { background: #dedcf6; }
	.work article > span { color: #4a4ab9; font-size: .68rem; font-weight: 850; }
	.work h3 { margin: 3.3rem 0 0; font-size: clamp(1.55rem, 3vw, 2.4rem); line-height: 1.05; letter-spacing: -.04em; }
	.work article p { margin: 1rem 0 0; color: #595970; font-size: .9rem; line-height: 1.7; }
	.before-enquiring { display: grid; grid-template-columns: minmax(0, .72fr) minmax(24rem, 1.28fr); gap: clamp(3rem, 9vw, 8rem); padding-block: clamp(5rem, 9vw, 8rem); border-top: 1px solid #d5d2c8; }
	.before-enquiring .section-heading { margin-bottom: 0; }
	.before-enquiring h2 { max-width: 8ch; }
	.faq-list { border-top: 1px solid #c9c6bd; }
	.faq-list details { border-bottom: 1px solid #c9c6bd; }
	.faq-list summary, .scope-details summary { padding: 1.35rem 2.5rem 1.35rem 0; cursor: pointer; font-size: 1.05rem; font-weight: 760; }
	.faq-list p { max-width: 60ch; margin: -.2rem 0 1.5rem; color: #595970; font-size: .9rem; line-height: 1.7; }
	.example-scope { padding-block: clamp(5rem, 9vw, 8rem); border-top: 1px solid #d5d2c8; }
	.example-scope .section-heading { max-width: 48rem; }
	.example-scope .section-heading > p:last-of-type { margin: 1.4rem 0 .65rem; color: #4f4f67; font-size: 1.05rem; line-height: 1.7; }
	.example-scope small { color: #6b6b7d; font-size: .78rem; }
	.scope-details { border-block: 1px solid #c9c6bd; }
	.scope-details dl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0 0 1.5rem; border-top: 1px solid #dedbd2; }
	.scope-details dl > div { padding: 1.25rem clamp(1rem, 4vw, 3rem) 0 0; }
	.scope-details dl > div:nth-child(even) { padding-right: 0; padding-left: clamp(1rem, 4vw, 3rem); border-left: 1px solid #dedbd2; }
	.scope-details dt { color: #4a4ab9; font-size: .72rem; font-weight: 850; letter-spacing: .08em; text-transform: uppercase; }
	.scope-details dd { margin: .55rem 0 0; color: #595970; font-size: .9rem; line-height: 1.7; }
	.process { display: grid; grid-template-columns: minmax(0, .9fr) minmax(22rem, 1.1fr); gap: clamp(3rem, 9vw, 8rem); padding: clamp(4rem, 7vw, 6rem); background: #10103f; color: #fff; }
	.process h2 { max-width: 11ch; }
	.eyebrow-light { color: #f8a51b; }
	.process ol { margin: 0; padding: 0; list-style: none; }
	.process li { display: grid; grid-template-columns: auto 1fr; gap: 1.3rem; padding: 1.5rem 0; border-bottom: 1px solid rgb(255 255 255 / 15%); }
	.process li:first-child { padding-top: 0; }
	.process li > span { color: #f8a51b; font-size: .7rem; font-weight: 850; }
	.process strong { font-size: 1.1rem; }
	.process p { margin: .5rem 0 0; color: rgb(255 255 255 / 70%); font-size: .9rem; line-height: 1.65; }
	.closing { display: grid; grid-template-columns: minmax(0, 1fr) minmax(20rem, .8fr); gap: clamp(3rem, 9vw, 8rem); padding-block: clamp(6rem, 11vw, 9rem); }
	footer { display: grid; grid-template-columns: 1fr auto 1fr; align-items: start; gap: 3rem; padding: 2.5rem 0 3rem; border-top: 1px solid #d0cdc3; color: #626277; font-size: .75rem; }
	footer p { max-width: 18rem; margin: 1rem 0 0; }
	footer nav { display: grid; grid-template-columns: repeat(2, auto); gap: .75rem 2rem; }
	.footer-contact { display: grid; justify-items: end; gap: .55rem; }
	.footer-contact a { font-weight: 720; text-decoration: none; }
	.footer-contact span { margin-top: .4rem; }
	@media (max-width: 760px) {
		.site-header, main > section, main > div, .service-switcher, .page-jumps, footer { width: min(100% - 2rem, 1120px); }
		.site-header nav a:not(.nav-cta) { display: none; }
		.hero, .fit, .before-enquiring, .process, .closing { grid-template-columns: 1fr; }
		.hero { min-height: auto; gap: 2rem; padding-block: 3.5rem 4rem; }
		h1 { font-size: clamp(3rem, 14vw, 4.4rem); }
		.service-switcher { align-items: flex-start; flex-direction: column; gap: .75rem; }
		.service-switcher > div { justify-content: flex-start; }
		.service-switcher a { min-height: 2.75rem; }
		.page-jumps { align-items: flex-start; }
		.page-jumps span { width: 100%; }
		.work-grid { grid-template-columns: 1fr; }
		.work article { min-height: 14rem; }
		.scope-details dl { grid-template-columns: 1fr; }
		.scope-details dl > div:nth-child(even) { padding-left: 0; border-left: 0; }
		.process { padding: 2rem 1.35rem; }
		footer { grid-template-columns: 1fr; }
		.footer-contact { justify-items: start; }
	}
</style>
