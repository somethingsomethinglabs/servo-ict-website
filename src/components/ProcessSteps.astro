---
interface Props { title: string; steps: Array<{ title: string; copy: string }>; note?: string; id?: string; eyebrow?: string; theme?: 'light' | 'dark' }
const { title, steps, note, id = 'process', eyebrow = 'How it works', theme = 'dark' } = Astro.props;
const divider = title.indexOf('. ');
const lead = divider < 0 ? title : title.slice(0,divider+1);
const emphasis = divider < 0 ? '' : title.slice(divider+2);
---
<section {id} class:list={["process-band", "section-space", theme === "dark" ? "material-black" : "material-silver"]} aria-labelledby={`${id}-title`} style={`--process-columns:${Math.max(1, Math.min(steps.length, 3))}`}><div class="container process-grid"><div>{eyebrow && <p class="eyebrow">{eyebrow}</p>}<h2 id={`${id}-title`}>{lead}{emphasis && <><br /><span>{emphasis}</span></>}</h2></div><div><ol>{steps.map((step, index) => <li><span class="step-number">{index + 1}</span><h3>{step.title}</h3><p>{step.copy}</p></li>)}</ol>{note && <p class="process-note">{note}</p>}</div></div></section>

<style>h2 span{color:var(--ink)}</style>
