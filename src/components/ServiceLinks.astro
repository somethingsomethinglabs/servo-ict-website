---
import * as ServiceChooser from './service-chooser';
import { sitePath } from '../lib/site';
interface Props { id?: string; eyebrow?: string; title?: string; copy?: string; includeStarter?: boolean; framed?: boolean; theme?: 'light' | 'dark' }
const { id, eyebrow, title = 'Looking for help with a job?', copy = 'Here are some common places to start.', includeStarter = false, framed = false, theme = 'light' } = Astro.props;
const links = [
 ...(includeStarter ? [{label:'Starting a business',href:sitePath('/start-a-business/')}] : []),
 {label:'Website help',href:sitePath('/websites/')},
 {label:'Computers, email and Wi-Fi',href:sitePath('/business-it/')},
 {label:'Account security',href:sitePath('/security/')}
];
---
<ServiceChooser.Root {id} {eyebrow} {title} {copy} {framed} {theme}>
 {links.map(link => <ServiceChooser.Link {...link} />)}
</ServiceChooser.Root>
