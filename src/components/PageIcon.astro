---
import arrowRight from '@phosphor-icons/core/assets/regular/arrow-right.svg?raw';
import arrowUpRight from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';
import envelope from '@phosphor-icons/core/assets/regular/envelope.svg?raw';
import phone from '@phosphor-icons/core/assets/regular/phone.svg?raw';
import file from '@phosphor-icons/core/assets/regular/file-text.svg?raw';
import pencil from '@phosphor-icons/core/assets/regular/pencil-simple.svg?raw';
import laptop from '@phosphor-icons/core/assets/regular/laptop.svg?raw';
import wifi from '@phosphor-icons/core/assets/regular/wifi-high.svg?raw';
import users from '@phosphor-icons/core/assets/regular/users-three.svg?raw';
import user from '@phosphor-icons/core/assets/regular/user-circle.svg?raw';
import shield from '@phosphor-icons/core/assets/regular/shield-check.svg?raw';
import gear from '@phosphor-icons/core/assets/regular/gear.svg?raw';
import tag from '@phosphor-icons/core/assets/regular/tag.svg?raw';
import plus from '@phosphor-icons/core/assets/regular/plus.svg?raw';
import pin from '@phosphor-icons/core/assets/regular/map-pin.svg?raw';
import chat from '@phosphor-icons/core/assets/regular/chats.svg?raw';
const icons: Record<string, string> = { arrowRight, arrowUpRight, envelope, phone, file, pencil, laptop, wifi, users, user, shield, gear, tag, plus, pin, chat };
interface Props { name: string; size?: number }
const { name, size = 24 } = Astro.props;
---
<span class="page-icon" style={`width:${size}px;height:${size}px`} aria-hidden="true" set:html={icons[name]} />
<style>.page-icon { display:inline-flex; flex-shrink:0; vertical-align:middle; } .page-icon :global(svg) { width:100%; height:100%; fill:currentColor; }</style>
