---
import FaqList from './FaqList.astro';
interface Props {
 id?: string;
 eyebrow?: string;
 title: string;
 copy?: string;
 items: Array<{ question: string; answer: string }>;
 theme?: 'light' | 'dark';
}
const { id = `faq-${crypto.randomUUID()}`, eyebrow = 'Common questions', title, copy, items, theme = 'light' } = Astro.props;
---
<section {id} class:list={['faq-section', 'section-space', theme === 'dark' ? 'material-black' : 'material-silver']} aria-labelledby={`${id}-title`}>
 <div class="container">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={`${id}-title`}>{title}</h2>
  {copy && <p class="lead">{copy}</p>}
  <FaqList {items} />
  <slot />
 </div>
</section>
<style>
 h2 { max-width:18ch; }
 .faq-section :global(.detail-list) { margin-top:2rem; }
</style>
