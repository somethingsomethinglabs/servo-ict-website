---
import PageIcon from './PageIcon.astro';
import { sitePath } from '../lib/site';
interface Props { eyebrow: string; headline: string; intro: string; service: string; action: string; image: string; imageAlt: string; website?: boolean }
const { eyebrow, headline, intro, service, action, image, imageAlt, website = false } = Astro.props;
const sentenceBreak = headline.indexOf('. ');
const note = website ? 'next-step-note' : service === 'security' ? 'security-note' : 'working-day-note';
const noteAlt = website ? 'Make the next step clear' : service === 'security' ? 'Small steps. Stronger accounts.' : 'Ready for the working day';
---
<section class:list={["service-hero", "section-space", {"website-hero":website}]}><div class="container split hero-grid"><div><p class="eyebrow">{eyebrow}</p><h1>{sentenceBreak < 0 ? headline : <>{headline.slice(0,sentenceBreak+1)}<br />{' '}{headline.slice(sentenceBreak+2)}</>}</h1><p class="lead">{intro}</p><div class="actions"><a class="button" href="#consultation-form">{action}<PageIcon name="arrowRight" size={22} /></a><a class="text-link" href={website ? '#work-example' : '#typical-work'}>{website ? 'See the work' : 'See what we help with'}</a></div><p class="local-note"><PageIcon name="shield" />Remote work. Gippsland visits by arrangement.</p></div><div class:list={['hero-art', { 'website-art': website }]}><img class="hero-note" src={sitePath(`/images/pages/${note}.webp`)} alt={noteAlt} width="600" height="500" /><img class="photo-frame" src={sitePath(image)} alt={imageAlt} width={website ? 1425 : 1000} height={website ? 891 : 1250} fetchpriority="high" /></div></div></section>
