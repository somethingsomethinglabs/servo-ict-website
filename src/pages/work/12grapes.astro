---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import PageClose from '../../components/PageClose.astro';
import PageIcon from '../../components/PageIcon.astro';
import { enquiryPath, sitePath } from '../../lib/site';
export const prerender = true;
---
<CaseStudyLayout title="12Grapes Vineyard Services — our work | Servo ICT" description="A service website and enquiry estimator for 12Grapes Vineyard Services in Gippsland, designed and built by Servo ICT." canonicalPath="/work/12grapes/"
 headline="A local business, ready to be found."
 client="12Grapes Vineyard Services"
 eyebrow="Local website project"
 intro="A website that explains the work and helps customers start an enquiry."
 facts={[{label:'Location',value:'Gippsland',icon:'pin'},{label:'Services',value:'Website design and writing',icon:'laptop'},{label:'Feature',value:'Enquiry estimator',icon:'file'}]}
 hero={{src:'/images/work/12grapes-website.jpg',alt:'The 12Grapes Vineyard Services website, showing vineyard services and its ground-management cost estimator.',width:1425,height:891}}
 projectLink={{href:'https://somethingsomethinglabs.com/website-12Grapes/',label:'View the 12Grapes website'}}
>
 <section class="section-space ruled-section"><div class="container">
  <p class="eyebrow">The business and the website</p><h2>Make the <span class="underline">next step</span> clear.</h2>
  <div class="split project-brief"><div><h3>The business need</h3><p class="lead">Explain vineyard services clearly and give Gippsland growers a useful way to ask about work.</p></div><div><h3>What we built</h3><p class="lead">Service information, clear contact routes and a project-specific enquiry estimator.</p></div></div>
 </div></section>
 <section class="section-space ruled-section"><div class="container">
  <div class="split project-detail"><div><p class="eyebrow">The enquiry estimator</p><h2>Useful details before the conversation.</h2><p class="lead">Growers choose their vineyard area and the work required to see an indicative planning range.</p><p class="fine-print">The estimate explains what can change the price and directs growers to confirm the job with the operator.</p></div><figure><img class="handover-image" src={sitePath('/images/pages/project-enquiry-flow.webp')} alt="Illustrative enquiry flow: describe the work, share the details, start an enquiry." width="1400" height="933" loading="lazy" /><figcaption>This estimator is an extra feature agreed for this project.</figcaption></figure></div>
  <p class="ownership-strip"><PageIcon name="shield" size={30} />A simple website can start with services, hours and a clear contact route.</p>
 </div></section>
 <section class="proof-band section-space"><div class="container split"><div><p class="eyebrow">What do you need?</p><h2>Choose the right starting point.</h2></div><div><p class="lead">Starting a new business? The starter package combines a small website with email and account setup. Existing businesses can discuss a larger or custom website.</p><div class="actions"><a class="button" href={enquiryPath('starter', sitePath('/work/12grapes/'))}>Enquire about the starter setup<PageIcon name="arrowRight" /></a><a class="text-link" href={enquiryPath('website', sitePath('/work/12grapes/'))}>Enquire about a website</a><a class="text-link" href={sitePath('/start-a-business/')}>See starter package details</a></div></div></div></section>
 <section id="about" class="process-band section-space"><div class="container split"><div><p class="eyebrow">About Servo ICT</p><h2>Local advice.<br />One point of contact.</h2><p>Servo ICT is owned and operated by Rowan Paterson in Gippsland.</p><p>Remote by default. Local visits by arrangement.</p><a class="text-link" href={sitePath('/about/')}>Read about Servo ICT<PageIcon name="arrowRight" /></a></div><div class="about-brand"><img src={sitePath('/images/servo-ict-logo.png')} alt="" width="150" height="150" /><span>Servo ICT</span></div></div></section>
 <PageClose slot="closing" compact title="Tell us about the business and the next step you want people to take." copy="A rough description is enough to start the conversation." action="Talk about my website" service="website" source={sitePath('/work/12grapes/')} />
</CaseStudyLayout>
<style>
 .project-brief { align-items:start; margin-top:3rem; }
 .project-brief > div + div { border-left:1px solid var(--line); padding-left:3rem; }
 .project-brief .lead { margin-top:1rem; }
 figure { margin:0; min-width:0; }figcaption{margin-top:1.25rem;color:var(--muted);font-size:.95rem}
 .ownership-strip { margin-top:3.5rem; }
 .proof-band .lead { margin:0; color:var(--ink); }
 .about-brand { display:flex; justify-content:center; align-items:center; gap:1.5rem; font-size:clamp(2rem,4.5vw,4rem); font-weight:700; letter-spacing:-.04em; }
 .about-brand img { filter:grayscale(1) brightness(0) invert(.79); width:clamp(70px,10vw,150px); height:auto; flex-shrink:0; }
 #about p:not(.eyebrow) { font-size:1.1rem; color:var(--ink-muted); max-width:35rem; }
 @media(max-width:1050px){.project-brief>div+div{padding-left:2rem}}
 @media(max-width:700px){.project-brief>div+div{padding:0;border:0}.about-brand{justify-content:start;padding-top:1rem}}
</style>
