---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import PageIcon from '../components/PageIcon.astro';
import PageClose from '../components/PageClose.astro';
import { sitePath, enquiryPath } from '../lib/site';
export const prerender = true;
export async function getStaticPaths() {
 return (await getCollection('blog', ({data}) => !data.draft)).map(post => ({params:{slug:post.id},props:{post}}));
}
interface Props { post:CollectionEntry<'blog'> }
const {post} = Astro.props;
const {Content,headings} = await render(post);
const contents = headings.filter(heading => heading.depth === 2);
const related = (await getCollection('blog', ({data}) => !data.draft)).filter(candidate => candidate.id !== post.id && candidate.data.topic === post.data.topic).sort((a,b) => b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf()).slice(0,2);
const readingTime = Math.max(1,Math.ceil((post.body?.split(/\s+/).length ?? 0)/200));
const startupArticle = post.data.topic === 'Starting a business';
const computerArticle = post.data.topic === 'Devices and updates';
const enquiryService = startupArticle ? 'starter' : computerArticle ? 'technology' : 'security';
const helpPath = startupArticle ? '/start-a-business/' : computerArticle ? '/business-it/' : '/security/';
---
<ArticleLayout enquiryTopic={enquiryService} title={`${post.data.title} | Servo ICT`} headline={post.data.title} description={post.data.description} canonicalPath={`/${post.id}/`} image={post.data.featuredImage} imageAlt={post.data.featuredImageAlt} topic={post.data.topic} author={post.data.author} publishedAt={post.data.publishedAt} updatedAt={post.data.updatedAt} {readingTime} headings={contents} helpLink={{href:sitePath(helpPath),label:'Need a hand?'}}>
 <Content />
 <Fragment slot="after-content"><aside class="article-help"><PageIcon name={computerArticle ? 'laptop' : 'shield'} size={38}/><div><h2>{startupArticle ? 'Ready to get your business set up?' : computerArticle ? 'Need help with your computers?' : 'Want a hand with account security?'}</h2><p>We can work through the setup with you and show you what you need to know.</p><a class="text-link" href={enquiryPath(enquiryService, sitePath(`/${post.id}/`))}>Talk it through<PageIcon name="arrowRight" size={20} /></a></div></aside></Fragment>
 <Fragment slot="after-article">
 {related.length > 0 && <section class="related section-space ruled-section"><div class="container"><div class="related-inner"><p class="eyebrow">Keep reading</p><h2>More useful advice.</h2><nav class="related-list" aria-label="Related advice">{related.map(item => <a href={sitePath(`/${item.id}/`)}><PageIcon name="file" size={28}/><span>{item.data.title}</span><PageIcon name="arrowRight" size={22}/></a>)}</nav></div></div></section>}
 <PageClose compact title="A rough description is enough to get started." copy="We can talk through the work and the next steps." service={enquiryService} />
 </Fragment>
</ArticleLayout>
<style>
 .article-help { display:flex; gap:1.5rem; padding:2rem; margin-top:3.5rem; background-color:var(--plastic); border:1px solid var(--line); }
 .article-help h2 { font-size:clamp(1.5rem,2.2vw,2rem); line-height:1.15; }
 .article-help .text-link { margin-top:1rem; }
 .related-inner { margin-left:calc(clamp(140px,17vw,220px) + clamp(3rem,7vw,7rem)); max-width:var(--reading-measure); }
 .related-list { display:grid; margin-top:2rem; }
 .related-list a { display:flex; align-items:center; gap:1.25rem; padding:1.3rem 0; border-bottom:1px solid var(--line); font-weight:700; text-decoration:none; }
 .related-list a span { margin-right:auto; }
 @media(max-width:1050px){.related-inner{margin-left:calc(clamp(140px,17vw,220px) + 2.5rem)}}
 @media(max-width:700px){.article-help{padding:1.5rem;gap:1rem;display:block}.article-help h2{margin-top:1rem}.related-inner{margin:0}.related-list a{gap:1rem}}
</style>
