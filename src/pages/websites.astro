---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import WebsiteOffer from '../components/WebsiteOffer.astro';
import WebsiteTechnology from '../components/WebsiteTechnology.astro';
import WorkExample from '../components/WorkExample.svelte';

export const prerender = true;
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<ServiceLayout
	title="Website design and development | Servo ICT"
	description="New websites, rebuilds and focused improvements for small businesses in Gippsland and across Victoria."
	canonicalPath="/websites/"
	eyebrow="Website design and development"
	headline="A website that helps customers choose and get in touch."
	intro="Servo ICT plans the pages, helps shape the wording and builds a site that works on phones and computers. Start with rough notes and the photos you have."
	goodFit={[
		'Your current site no longer reflects the business.',
		'Visitors struggle to understand what you offer or what to do next.',
		'Updates are awkward, unreliable or depend on the wrong person.',
		'You are starting from scratch and need help turning business details into a finished site.'
	]}
	typicalWork={[
		{ title: 'New websites', description: 'Give customers the services, prices, hours or service area they need, with a clear way to call or enquire.' },
		{ title: 'Rebuilds', description: 'Keep what still works, improve the structure and replace the parts that create confusion or friction.' },
		{ title: 'Writing and structure', description: 'Turn a conversation, rough notes and supplied photos into clear pages for customers to check.' },
		{ title: 'Care and improvements', description: 'Fix specific issues, improve important pages or agree on sensible ongoing care after launch.' }
	]}
	enquiryService="website"
	beforeEnquiring={[
		{
			question: 'Who provides the website content?',
			answer: 'You provide the business facts, service details, existing brand material and images. The custom website scope includes page planning and draft writing based on the workshop and that material. You check the facts, prices and claims before publication.'
		},
		{
			question: 'Can the site link to my booking system?',
			answer: 'Yes. A normal button to an existing booking service can be included in the agreed site scope. Building a new booking system, customer login or complex connection between services is custom software and needs a separate quote.'
		},
		{
			question: 'Is ongoing care included?',
			answer: 'The managed payment option includes defined care during its 24-month term. After that, or for an outright project, ongoing care is quoted around the support you need.'
		}
	]}
	exampleScope={{
		scenario: 'A local service business has an ageing website. Its services have changed, customers cannot find the right contact path and routine updates have become difficult.',
		work: 'Run a planning workshop, write and design up to five core pages, build one agreed calculator or guided enquiry, complete two review rounds and prepare the site for launch.',
		inputs: 'Access to the current website and domain, service details, existing brand material, images and feedback from the person approving the work.',
		timing: 'Before work starts, the proposal confirms the scope, price, responsibilities and delivery dates.',
		handover: 'You receive the working website, agreed account access and practical notes for routine updates, along with any next steps agreed during the project.'
	}}
	closingTitle="Bring the business problem, not a technical brief."
	closingCopy="A rough description of the site you have, the result you need and what is getting in the way is enough to start."
>
	<WebsiteOffer slot="offer" />
	<WebsiteTechnology slot="technology" />
	<WorkExample slot="proof" {baseUrl} />
</ServiceLayout>
