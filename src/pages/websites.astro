---
import ServiceLayout from '../layouts/ServiceLayout.astro';

export const prerender = true;
---

<ServiceLayout
	title="Website design and development | Servo ICT"
	description="New websites, rebuilds and focused improvements for small businesses in Gippsland and across Victoria."
	canonicalPath="/websites/"
	eyebrow="Website design and development"
	headline="Websites that make the next step clear."
	intro="For small businesses that need a new site, a thoughtful rebuild or a focused improvement. Servo ICT helps shape the structure, build the site and leave you with a clear way to look after it."
	goodFit={[
		'Your current site no longer reflects the business.',
		'Visitors struggle to understand what you offer or what to do next.',
		'Updates are awkward, unreliable or depend on the wrong person.',
		'You need someone to coordinate the content, build and technical setup.'
	]}
	typicalWork={[
		{ title: 'New websites', description: 'Plan and build a focused website around your audience, services and most important next step.' },
		{ title: 'Rebuilds', description: 'Keep what still works, improve the structure and replace the parts that create confusion or friction.' },
		{ title: 'Content and structure', description: 'Turn scattered ideas into a practical page plan and clear, credible messaging.' },
		{ title: 'Care and improvements', description: 'Fix specific issues, improve important pages or agree on sensible ongoing care after launch.' }
	]}
	closingTitle="Bring the business problem, not a technical brief."
	closingCopy="A rough description of the site you have, the result you need and what is getting in the way is enough to start."
/>
