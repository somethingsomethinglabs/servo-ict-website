---
import '@fontsource-variable/inter/wght.css';
import '../styles/brand.css';
import LandingPage from '../components/LandingPage.svelte';
import { getEnquirySettings } from '../lib/server/enquirySettings';

export const prerender = import.meta.env.PUBLIC_SITE_MODE === 'static';

const {consultationMode,turnstileSiteKey} = getEnquirySettings();
const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const siteOrigin = Astro.site ?? new URL('https://servoict.com');
const canonicalUrl = new URL(baseUrl, siteOrigin);
const socialImageUrl = new URL(`${baseUrl}og.png`, siteOrigin);

const organisationSchema = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'Servo ICT',
	url: canonicalUrl.toString(),
	logo: new URL(`${baseUrl}images/servo-ict-logo.png`, siteOrigin).toString(),
	email: 'support@servoict.com',
	telephone: '+61-3-4148-8665',
	areaServed: ['Gippsland', 'Victoria'],
	knowsAbout: ['Website design and development', 'Business IT', 'Small business cyber security']
};

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={`${baseUrl}images/servo-ict-logo.png`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Starting a business in Gippsland? Get your website, business email and essential accounts set up together, with clear costs and a practical walkthrough."
		/>
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Servo ICT" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content="Starting a business? Let's get the basics sorted." />
		<meta
			property="og:description"
			content="Your website, business email and essential account setup, handled together. Clear costs before we start, and help with the few things you need to know."
		/>
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:image:alt" content="Servo ICT: Websites and technology, built properly." />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="Starting a business? Let's get the basics sorted." />
		<meta
			name="twitter:description"
			content="Your website, business email and essential account setup, handled together. Clear costs before we start, and help with the few things you need to know."
		/>
		<meta name="twitter:image" content={socialImageUrl} />
		<meta name="twitter:image:alt" content="Servo ICT: Websites and technology, built properly." />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(organisationSchema)}></script>
		<title>Servo ICT | Website &amp; business email setup in Gippsland</title>
	</head>
	<body>
		<LandingPage client:load {turnstileSiteKey} {consultationMode} {baseUrl} />
		{
			turnstileSiteKey && (
				<script
					is:inline
					src="https://challenges.cloudflare.com/turnstile/v0/api.js"
					async
					defer
				></script>
			)
		}
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
	}
</style>
