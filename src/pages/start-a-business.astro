---
import PageLayout from '../layouts/PageLayout.astro';
import EnquiryForm from '../components/EnquiryForm.svelte';
import Icon from '../components/Icon.svelte';
import PageIcon from '../components/PageIcon.astro';
import WorkExample from '../components/WorkExample.svelte';
import { starterOffer, starterSetupPrice } from '../lib/starterOffer';
import { baseUrl, enquiryPath, sitePath } from '../lib/site';
import { getEnquirySettings } from '../lib/server/enquirySettings';

export const prerender = import.meta.env.PUBLIC_SITE_MODE === 'static';
const { consultationMode, turnstileSiteKey } = getEnquirySettings();
---

<PageLayout title="Business starter setup | Servo ICT" description="A website, one business mailbox and essential account setup for a new small business, from A$1,500 plus third-party costs." canonicalPath="/start-a-business/" active="starter" {turnstileSiteKey}>
	<section class="service-hero section-space" aria-labelledby="starter-title"><div class="container split hero-grid"><div><p class="eyebrow">Business starter setup</p><h1 id="starter-title">Get the online basics ready for customers.</h1><p class="lead">For a new small business that needs a clear website, a professional email address and the essential accounts set up together.</p><div class="actions"><a class="button" href="#consultation-form">Ask about the setup <Icon name="arrowRight" size={22} /></a><a class="text-link" href="#scope">See what is included</a></div><p class="local-note"><Icon name="shieldCheck" size={26} /> One point of contact. Remote setup, with Gippsland visits by arrangement.</p></div><div class="hero-art"><img class="hero-note" src={sitePath('/images/illustrations/ideas-to-customers.webp')} width="768" height="750" alt="From ideas to customers" /><img class="photo-frame" src={sitePath('/images/illustrations/new-business-storefront.webp')} width="1122" height="1402" alt="A New Business sign hanging in a shop window." /></div></div></section>

	<section id="scope" class="section-space ruled-section"><div class="container"><p class="eyebrow">What is included</p><h2>A defined starting point.</h2><p class="lead">The written quote confirms that this scope fits your business before any work starts.</p><div class="outcome-grid">{starterOffer.inclusions.map((item) => <article class="outcome"><Icon name="shieldCheck" size={30} /><div><h3>{item}</h3></div></article>)}</div><div class="scope-exclusions"><h3>Not included in the starter setup</h3><ul>{starterOffer.exclusions.map((item) => <li>{item}</li>)}</ul></div><div class="ownership-strip"><Icon name="shieldCheck" size={30} /><span>Your business keeps the website, domain and email accounts in its name, with the agreed access and recovery details.</span></div></div></section>

	<section id="cost" class="section-space ruled-section"><div class="container split cost-grid"><div><p class="eyebrow">Cost</p><h2>{starterSetupPrice} setup fee.</h2><p class="lead">This covers the starter scope above. {starterOffer.taxNote} Payment terms are confirmed in your quote.</p><div class="actions"><a class="text-link" href="#consultation-form">Check whether it fits your business</a></div></div><dl class="cost-list"><div><dt><Icon name="gear" size={28} /> Setup</dt><dd>{starterOffer.setupPriceDisplay} for the quote-confirmed starter scope.</dd></div><div><dt><Icon name="creditCard" size={28} /> Yearly running costs</dt><dd><strong>{starterOffer.annualBudgetNote.display}</strong>. {starterOffer.annualBudgetNote.label}. {starterOffer.annualBudgetNote.description}</dd></div><div><dt><Icon name="plus" size={28} /> Work outside scope</dt><dd>{starterOffer.laterWork}</dd></div></dl></div></section>

	<section class="proof-band section-space" aria-label="Relevant work"><div class="container"><WorkExample baseUrl={baseUrl} compact /></div></section>
	<section class="proof-cta"><div class="container split"><div><p class="eyebrow">Have something similar in mind?</p><h2>Tell us what your new business needs.</h2></div><div><p>We will check whether the starter scope fits and confirm the setup, running costs and responsibilities in writing.</p><a class="button" href={enquiryPath('starter', sitePath('/start-a-business/'))}>Ask about the starter setup <Icon name="arrowRight" size={22} /></a></div></div></section>

	<section id="process" class="process-band section-space"><div class="container process-grid"><div><p class="eyebrow">What we need from you</p><h2>Your business facts, your choices and one round of feedback.</h2><p class="process-note">You approve the facts, prices and claims before the website goes live. Never send passwords through the enquiry form.</p></div><ol><li><span class="step-number">1</span><div><h3>Scope and quote</h3><p>Tell us what the business does, who it helps and what you already have. We confirm fit, responsibilities, costs and timing in writing.</p></div></li><li><span class="step-number">2</span><div><h3>Build and review</h3><p>Provide your business details, logo and usable photos. We prepare the setup, then you return one consolidated review.</p></div></li><li><span class="step-number">3</span><div><h3>Launch and walkthrough</h3><p>We test the agreed setup, give you account access and show you how to use the mailbox and find the key settings.</p></div></li></ol></div></section>

	<section class="section-space ruled-section"><div class="container"><p class="eyebrow">After launch</p><h2>You keep control of the accounts.</h2><p class="lead">The walkthrough covers the everyday tasks in the agreed setup. Keep recovery details safe and tell us when a person should no longer have access.</p><div class="detail-list"><details open><summary>What happens when I need a change?</summary><p>{starterOffer.laterWork} We confirm the cost and timing before making the change.</p></details><details><summary>Can I add more pages or email users?</summary><p>Yes, but they sit outside this starter scope. Tell us what you need and we will quote the extra work and any additional subscription costs.</p></details><details><summary>How long will it take?</summary><p>Timing depends on availability, the material you provide and the final scope. {starterOffer.quoteNote}</p></details></div></div></section>

	<section class="page-close section-space" aria-labelledby="enquiry-title"><div class="container split closing-grid with-form"><div><p class="eyebrow">Get in touch</p><h2 id="enquiry-title">Tell us what you're starting.</h2><p class="lead">A rough description is enough. We aim to reply within two business days and will ask for the details needed to confirm a quote.</p><a class="phone-link" href="tel:0341488665"><PageIcon name="phone" /> (03) 4148 8665</a><p class="fine-print">Monday, Tuesday and Friday, 9am to 4pm.</p></div><EnquiryForm client:load {baseUrl} {consultationMode} {turnstileSiteKey} defaultService="starter" source="start_business" returnPath={sitePath('/start-a-business/')} expanded /></div></section>
</PageLayout>

<style>
	#scope .scope-exclusions{margin-top:2rem;padding:1.5rem;border:1px solid var(--line);color:var(--muted)}#scope .scope-exclusions h3{margin-top:0;color:var(--ink);font-size:1.05rem}#scope .scope-exclusions ul{margin-bottom:0;padding-left:1.25rem}#scope .scope-exclusions li+li{margin-top:.5rem}#scope .outcome-grid{grid-template-columns:repeat(2,minmax(0,1fr))}#scope .outcome{align-items:center}#scope .outcome h3{font-size:1.05rem;letter-spacing:-.01em}#scope .ownership-strip{margin-top:2.5rem}.proof-band :global(.work-example){padding:0;background:none}.proof-cta{padding-block:clamp(2rem,5vw,4rem);background:var(--plastic);border-bottom:1px solid var(--line)}.proof-cta p{color:var(--ink-muted);line-height:1.7}.proof-cta .button{margin-top:1rem}.with-form{align-items:start}.with-form>:global(form){min-width:0}.process-note{color:var(--ink-muted)}
	@media(max-width:700px){#scope .outcome-grid{grid-template-columns:1fr}.with-form{grid-template-columns:1fr}}
</style>
