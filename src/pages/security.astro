---
import ServiceLayout from '../layouts/ServiceLayout.astro';

export const prerender = true;
---

<ServiceLayout
	title="Practical small business security | Servo ICT"
	description="Practical sign-in, access, automatic update and file recovery improvements for small businesses, delivered remotely or in Gippsland by arrangement."
	canonicalPath="/security/"
	eyebrow="Practical security"
	headline="Protect the accounts and files your business relies on."
	intro="Servo ICT helps you strengthen sign-in, remove access that should no longer be there, check automatic updates and work out whether important files can be recovered. Work is remote by default, with Gippsland visits by arrangement."
	goodFit={[
		'Important accounts do not have strong sign-in protection.',
		'Staff or suppliers may still have access they no longer need.',
		'Updates and device settings have become inconsistent.',
		'Backups exist, but no one is confident they can be restored.'
	]}
	typicalWork={[
		{ title: 'Safer sign-in', description: 'Strengthen sign-in and recovery details for the important services your business uses.' },
		{ title: 'Access review', description: 'Map who can reach critical systems and remove access that is unclear or no longer needed.' },
		{ title: 'Automatic updates', description: 'Check whether suitable computers receive important updates and agree on any settings that need attention.' },
		{ title: 'File recovery', description: 'Review what is backed up, where it is stored and how the business would restore important files.' }
	]}
	enquiryService="security"
	beforeEnquiring={[
		{
			question: 'What will the work cost?',
			answer: 'Security projects are quoted after the systems, equipment and work involved are confirmed. The written proposal lists the scope, fee, schedule, any travel costs and third-party fees. You approve it before work begins.'
		},
		{
			question: 'Can you help with an urgent cyber incident?',
			answer: 'This service covers planned security improvements. Urgent work depends on availability and does not include guaranteed incident response. For an active cyber incident, contact the Australian Cyber Security Hotline on 1300 CYBER1 (1300 292 371).'
		},
		{
			question: 'What should I include in the enquiry?',
			answer: 'Name the services and devices involved, describe the issue you are worried about and state any deadline or business impact.'
		},
		{
			question: 'Do I need to share passwords to enquire?',
			answer: 'No. Describe the issue and affected services, but do not include passwords, recovery codes or other credentials. Any access needed for agreed work is identified during scoping.'
		},
		{
			question: 'What security software do you use?',
			answer: 'For Windows computers, Microsoft Defender Antivirus, Windows Firewall and automatic updates are the starting point when they suit the device, business needs and risks. Any additional security software is considered during scoping and quoted if needed.'
		},
		{
			question: 'Can you secure Macs?',
			answer: 'Windows is the core supported desktop platform. For macOS work, enquire with the device and issue details so Servo ICT can assess whether the project is a fit.'
		},
		{
			question: 'Is this an ongoing security subscription?',
			answer: 'The main service is a defined security setup or improvement project for systems your business manages. Automatic updates and an optional check-in roughly every six months can be agreed as part of the project. The check-in reviews access, update status and recovery arrangements; it does not provide continuous monitoring.'
		}
	]}
	exampleScope={{
		scenario: 'A small business knows sign-in protection is inconsistent, old access may still exist and no one has checked whether important backups can be restored.',
		work: 'Review the priority accounts, access list, device update settings and backup arrangement, then apply the safeguards agreed for the most important gaps.',
		inputs: 'Administrative access, a current staff and supplier list, details of key devices and services, and someone authorised to approve access changes.',
		timing: 'The initial review establishes which systems are included and how changes will be coordinated. You receive a written scope, quote and schedule before changes start.',
		handover: 'You receive the agreed protections, an updated access record, recovery notes and a prioritised list of any follow-up work.'
	}}
	closingTitle="Start with the risk that worries you most."
	closingCopy="Name the account, computer or files you depend on and what concerns you. Servo ICT can help work out what needs attention first."
/>
