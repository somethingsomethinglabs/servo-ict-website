---
import BlogLayout from '../layouts/BlogLayout.astro';
import { resolveConsultationMode } from '../lib/consultationEmail';

export const prerender = import.meta.env.PUBLIC_SITE_MODE === 'static';
const isStatic = import.meta.env.PUBLIC_SITE_MODE === 'static';
const turnstileEnabled = !isStatic && Boolean(process.env.PUBLIC_TURNSTILE_SITE_KEY ?? import.meta.env.PUBLIC_TURNSTILE_SITE_KEY);
const enquiryMode = resolveConsultationMode({
	staticSite: isStatic,
	hasTurnstileSiteKey: turnstileEnabled,
	allowInsecureLocal: (process.env.FORM_ALLOW_INSECURE_LOCAL ?? import.meta.env.FORM_ALLOW_INSECURE_LOCAL) === 'true',
	isDevelopment: import.meta.env.DEV
});
---

<BlogLayout
	title="Privacy | Servo ICT"
	description="How Servo ICT handles information submitted through this website."
	canonicalPath="/privacy/"
>
	<article class="privacy-page">
		<p class="eyebrow">Privacy</p>
		<h1>How your enquiry information is handled.</h1>
		<p class="lead">Servo ICT only asks for the information needed to understand and reply to your enquiry.</p>

		<section>
			<h2>Information you provide</h2>
			<p>When you email, call or use the project enquiry form, you may provide your name, contact details, organisation and information about the work you need help with. Do not include passwords or recovery codes.</p>
		</section>

		<section>
			<h2>How the enquiry is sent</h2>
			{enquiryMode === 'email' ? (
				<p>Choose <strong>Open email draft</strong> to prepare your enquiry in your device's email app. Review it and press Send yourself. If the app does not open, choose <strong>Copy enquiry instead</strong>, then paste it into an email to <a href="mailto:support@servoict.com">support@servoict.com</a>.</p>
			) : (
				<p>Choose <strong>Send enquiry</strong> to send your details directly to Servo ICT. The page confirms whether it was sent and provides an email fallback if delivery fails. {turnstileEnabled && 'A spam check helps prevent automated submissions.'}</p>
			)}
		</section>

		<section>
			<h2>How it is used</h2>
			<p>Servo ICT uses that information to respond, discuss the project and provide services if you decide to proceed. It is not sold or used for advertising.</p>
		</section>

		<section>
			<h2>Website hosting</h2>
			{isStatic ? <p>This website is hosted using GitHub Pages. GitHub may process technical request information needed to deliver the site and keep the service secure.</p> : <p>The website host may process technical request information needed to deliver the site and keep it secure.</p>}
		</section>

		<section>
			<h2>Questions or corrections</h2>
			<p>To ask what information Servo ICT holds about you, request a correction or raise a privacy question, email <a href="mailto:support@servoict.com">support@servoict.com</a>.</p>
		</section>
		<p class="updated">Last updated: 15 September 2026</p>
	</article>
</BlogLayout>

<style>
	.privacy-page { width: min(100% - 3rem, 760px); margin: 0 auto; padding: clamp(5rem, 10vw, 8rem) 0; }
	.eyebrow { margin: 0 0 1.2rem; color: var(--colour-feature); font-size: .72rem; font-weight: 850; letter-spacing: .13em; text-transform: uppercase; }
	h1 { max-width: 11ch; margin: 0; font-size: clamp(3rem, 7vw, 5.5rem); line-height: .98; letter-spacing: -.052em; }
	.lead { margin: 2rem 0 4rem; color: var(--colour-text-muted); font-size: 1.15rem; line-height: 1.75; }
	section { padding: 2rem 0; border-top: 2px solid var(--colour-text); }
	a { text-decoration-color: var(--colour-accent); text-decoration-thickness: 3px; text-underline-offset: .2rem; }
	h2 { margin: 0 0 .8rem; font-size: 1.35rem; letter-spacing: -.025em; }
	section p { margin: 0; color: var(--colour-text-muted); line-height: 1.75; }
	.updated { margin: 2rem 0 0; color: var(--colour-text-muted); font-size: .75rem; }
	@media (max-width: 700px) { .privacy-page { width: min(100% - 2rem, 760px); } }
</style>
