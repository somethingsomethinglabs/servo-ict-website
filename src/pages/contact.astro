---
import PageLayout from '../layouts/PageLayout.astro';
import EnquiryForm from '../components/EnquiryForm.svelte';
import ServiceLinks from '../components/ServiceLinks.astro';
import { getEnquirySettings } from '../lib/server/enquirySettings';
import { baseUrl, sitePath } from '../lib/site';
export const prerender = import.meta.env.PUBLIC_SITE_MODE === 'static';
const {consultationMode,turnstileSiteKey} = getEnquirySettings();
const nextSteps = [
 {title:'We reply',copy:'We check what you need and whether the work is a fit.'},
 {title:'We talk it through',copy:'We clarify the result, what you have already and any timing constraints.'},
 {title:'You get a written quote',copy:'The work, costs and responsibilities are clear before you approve it.'}
];
---
<PageLayout title="Get in touch | Servo ICT" description="Talk with Servo ICT about starting a business, a website or everyday IT. Remote work and Gippsland visits by arrangement." canonicalPath="/contact/" active="contact" {turnstileSiteKey}>
 <section class="contact-panel" aria-labelledby="contact-title"><div class="contact-heading"><p class="eyebrow">Get in touch</p><h1 id="contact-title">Tell us what you need a hand with.</h1><p class="lead">A rough description is enough. We aim to reply within two business days.</p></div><div class="form-panel"><h2>Your enquiry</h2><EnquiryForm client:load {baseUrl} {turnstileSiteKey} {consultationMode} expanded returnPath={sitePath('/contact/')} /></div><aside class="contact-intro" aria-label="Other ways to get in touch"><h2>Prefer to call?</h2><a class="contact-phone" href="tel:0341488665" data-enquiry-phone data-source="contact">(03) 4148 8665</a><p class="hours">Phone hours: Monday, Tuesday and Friday, 9am–4pm.</p><p class="lead">Remote work. Gippsland visits by arrangement.</p><a class="contact-email" href="mailto:support@servoict.com">support@servoict.com</a></aside></section>
 <section class="section-space"><div class="container"><p class="eyebrow">After your enquiry</p><h2>What happens next?</h2><ol class="next-steps">{nextSteps.map((step,index) => <li><span class="step-number" aria-hidden="true">{index+1}</span><div><h3>{step.title}</h3><p>{step.copy}</p></div></li>)}</ol><p class="availability-note">Your enquiry starts a conversation. We agree the scope and timing before work begins. Urgent IT or security work depends on availability; there is no guaranteed emergency response.</p></div></section>

 <section class="section-space"><div class="container"><p class="eyebrow">Explore further</p><ServiceLinks title="Still working out what you need?" copy="Have a look at these pages for more information. When you’re ready, you can get in touch." includeStarter /></div></section>
</PageLayout>
<style>
	 .contact-panel { width:100%; margin-inline:auto; padding:var(--section-space-compact) var(--page-inset); display:grid; grid-template-columns:minmax(0,1.25fr) minmax(17rem,.7fr); gap:clamp(2rem,5vw,4.5rem); align-items:start; background-color:var(--plastic); border-block:1px solid var(--seam); box-shadow:inset 0 1px 0 var(--edge); }
	 .contact-heading { grid-column:1 / -1; max-width:54rem; }
	 .contact-heading h1 { max-width:24ch; font-size:clamp(2rem,3.8vw,3.4rem); }
	 .contact-heading .lead,.contact-intro .lead { color:var(--ink-muted); font-size:1.12rem; }
	 .contact-intro { padding:2rem 0 0 clamp(1.5rem,3vw,2.5rem); border-left:1px solid var(--line); }
	 .contact-intro a { display:flex; align-items:center; min-height:44px; font-weight:700; text-decoration:none; }
	 .contact-phone { font-size:clamp(1.5rem,2.7vw,2.5rem); letter-spacing:-.04em; }
	 .contact-email { margin-top:1.25rem; font-size:clamp(1.05rem,1.65vw,1.5rem); overflow-wrap:anywhere; }
	 .hours { color:var(--ink-muted); font-size:.95rem; max-width:24rem; }
	 .form-panel { min-width:0; }
 .form-panel h2 { font-size:1.8rem; margin:0 0 2rem; letter-spacing:-.04em; }
 .next-steps { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); list-style:none; padding:2rem 0 0; margin:2rem 0 0; border-top:1px solid var(--ink); }
 .next-steps li { display:flex; align-items:start; gap:1.5rem; padding-inline:2rem; border-left:1px solid var(--line); }
 .next-steps li:first-child { padding-left:0; border:0; }.next-steps li:last-child{padding-right:0}
 .next-steps li > div { min-width:0; }
 .next-steps .step-number { flex-shrink:0; }.next-steps p{color:var(--muted)}
 .availability-note { margin-top:2rem; padding-top:1.5rem; border-top:1px solid var(--line); color:var(--muted); }
 @media(max-width:1050px) {
  .next-steps { grid-template-columns:1fr; gap:1.5rem; }
  .next-steps li { padding:0; border:0; }
 }

	 @media(max-width:1050px){.contact-panel{gap:2rem}.next-steps li{gap:1rem}.next-steps h3{font-size:1.1rem}}
	 @media(max-width:700px){.contact-panel{grid-template-columns:1fr}.contact-heading{grid-column:auto}.contact-heading h1{max-width:22ch}.contact-panel{width:100%;padding:3rem var(--page-inset);gap:2.5rem}.contact-intro{padding:2rem 0 0;border-left:0;border-top:1px solid var(--line)}.next-steps{grid-template-columns:1fr;gap:2rem}.next-steps li{padding:0;border:0}.next-steps h3{font-size:1.2rem}}
</style>
